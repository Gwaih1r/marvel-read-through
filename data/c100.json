[["a","Marvels Annotated (2019) #1-4","","13 Feb 2019 - 24 Jul 2019",30472],["n","Kurt Busiek and Alex Ross's Marvels (1994, reissued with bonus material as Marvels Annotated in 2019) follows photographer Phil Sheldon through the rise of the heroes. Busiek wrote the Eye of the Camera sequel in 2008 and reunited with Ross for the 2019 Epilogue."],["i",1,"Marvels Annotated (2019) #1","","",170,[24]],["i",2,"Marvels Annotated (2019) #2","","",170,[24]],["i",3,"Marvels Annotated (2019) #3","","",170,[24]],["i",4,"Marvels Annotated (2019) #4","","",170,[24]],["a","Marvels Epilogue (2019) #1","","",31764],["i",5,"Marvels Epilogue (2019) #1","","",171,[24,33]],["a","Marvels: Eye of the Camera (2008) #1-6","","",22499],["i",6,"Marvels: Eye of the Camera (2008) #1","","",172,[24]],["i",7,"Marvels: Eye of the Camera (2008) #2","","",172,[24]],["i",8,"Marvels: Eye of the Camera (2008) #3","","",172,[24,32]],["i",9,"Marvels: Eye of the Camera (2008) #4","","",172,[24,32]],["i",10,"Marvels: Eye of the Camera (2008) #5","","",172,[24,32]],["i",11,"Marvels: Eye of the Camera (2008) #6","","",172,[24,32]],["a","History of the Marvel Universe (2019) #3-4","","24 Jul 2019 - 16 Oct 2019",30614],["n","Read only #3-4. Issues #1-2 cover early history the modern era reveals later, and #5-6 spoil stories ahead. Skip the reference section in the back half of each issue unless you want the deep dive. The guide follows this with background notes on Heroes Return, Spider-Man, the X-Men, Scarlet Witch and Thor that are worth reading on the site."],["i",12,"History of the Marvel Universe (2019) #3","","",130,[25,27]],["i",13,"History of the Marvel Universe (2019) #4","","",130,[25,27]],["a","The Sentry (2000) #1-5","","1 Sep 2000 - 1 Feb 2001",8831],["n","Marked as an Event in the guide, meaning it affects most of the Marvel universe. Introduces the Sentry, a new character who matters to many stories ahead."],["i",14,"The Sentry (2000) #1","","",230,[29]],["i",15,"The Sentry (2000) #2","","",230