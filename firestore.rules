rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read the progress (so Claude can pull stats); only Kyle's account can change it.
    match /progress/{chapter} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "kylefoleywrites@gmail.com";
    }
  }
}
